# Copiá este archivo a .env y completá los valores. Nunca subas .env al repositorio.
# Una variable vacía cuenta como no definida: las opcionales toman su default.

# --- Proxy LiteLLM (obligatorias) -------------------------------------------
# URL y clave personal que entrega el equipo docente.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Modelos (obligatorias) --------------------------------------------------
# Elegidos con notebooks/00_litellm_exploracion.ipynb (decisión D-001):
#   LLM_MODEL=gpt-5.4-mini
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIM=1536
# EMBEDDING_DIM tiene que coincidir con la dimensión del índice de Pinecone.
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Pinecone ----------------------------------------------------------------
# Obligatoria: API key de pinecone.io (plan Starter gratuito).
PINECONE_API_KEY=
# Default: mas-2026s2-tables (se crea solo en la primera ingesta).
PINECONE_INDEX_NAME=
# Opcionales para crear el índice serverless. Defaults: aws / us-east-1.
PINECONE_CLOUD=
PINECONE_REGION=

# --- LangSmith ---------------------------------------------------------------
# Default: true. Las trazas tienen que estar activadas en cada ejecución.
LANGSMITH_TRACING=
# Obligatoria: API key de smith.langchain.com (Settings -> API Keys).
LANGSMITH_API_KEY=
# Obligatoria: mas-2026s2-<tu-legajo>
LANGSMITH_PROJECT=

# --- Opcionales ----------------------------------------------------------------
# Almacén de tablas Parquet + JSON. Default: data/tables
TABLES_DIR=
# Reintentos de enriquecimiento de metadatos (BR-011). Default: 2
MAX_ENRICH_RETRIES=
# Reintentos de generación de código (BR-011). Default: 3
MAX_CODE_RETRIES=
# Tablas candidatas por consulta de búsqueda. Default: 5
RETRIEVAL_TOP_K=
# Timeout del sandbox en segundos (BR-012). Default: 30
SANDBOX_TIMEOUT_S=
# Caché SQLite local de respuestas del LLM (.langchain.db). Default: false (usar true en desarrollo)
LLM_CACHE=
# Tope de tablas lógicas por PDF. Default: 40
MAX_TABLES_PER_PDF=
