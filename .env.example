# Copiá este archivo a .env (Copy-Item .env.example .env) y completá los valores.
# Nunca subas .env al repositorio (está en .gitignore).
# Una variable vacía cuenta como no definida: las opcionales toman su default.
# Si falta una obligatoria, la app muestra cuáles y deshabilita las pestañas que la necesitan.

# --- Proxy LiteLLM (obligatorias) -------------------------------------------
# URL y clave personal que entrega el equipo docente.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Modelos (obligatorias) --------------------------------------------------
# Valores usados en el proyecto (elegidos con notebooks/00_litellm_exploracion.ipynb):
#   LLM_MODEL=gpt-5.4-mini
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIM=1536
# EMBEDDING_DIM tiene que coincidir con la dimensión del índice de Pinecone; cambiar de modelo
# de embeddings obliga a usar otro índice (la app avisa si no coinciden y no escribe).
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Pinecone ----------------------------------------------------------------
# Obligatoria: API key de pinecone.io (plan Starter gratuito).
PINECONE_API_KEY=
# Default: mas-2026s2-tables (se crea solo en la primera ingesta).
PINECONE_INDEX_NAME=
# Opcionales para crear el índice serverless. Defaults: aws / us-east-1.
PINECONE_CLOUD=
PINECONE_REGION=

# --- LangSmith ---------------------------------------------------------------
# Default: true. Las trazas tienen que estar activadas en cada ejecución.
LANGSMITH_TRACING=
# Obligatoria: API key de smith.langchain.com (Settings -> API Keys).
LANGSMITH_API_KEY=
# Obligatoria: mas-2026s2-<tu-legajo>
LANGSMITH_PROJECT=

# --- Opcionales ----------------------------------------------------------------
# Almacén de tablas Parquet + JSON. Default: data/tables
TABLES_DIR=
# Reintentos de enriquecimiento de metadatos por tabla. Default: 2
MAX_ENRICH_RETRIES=
# Reintentos de generación de código por pregunta. Default: 3
MAX_CODE_RETRIES=
# Tablas candidatas por consulta de búsqueda. Default: 5
RETRIEVAL_TOP_K=
# Timeout de cada ejecución de código en el sandbox, en segundos. Default: 30
SANDBOX_TIMEOUT_S=
# Caché SQLite local de respuestas del LLM (.langchain.db). Default: false.
# En desarrollo usá true (o $env:LLM_CACHE="true", que gana sobre este archivo) para no gastar
# presupuesto del proxy; para medir latencias y llamadas reales (evaluación), false.
LLM_CACHE=
# Tope de tablas lógicas por PDF. Default: 40
MAX_TABLES_PER_PDF=
